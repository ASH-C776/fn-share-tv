<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- ViewerScreen 的 ZOOM_LABEL_RES 是 List<Int>，.map 是 kotlin.collections 扩展，
         不是 Flow 操作符；组合期调 stringResource 是必需写法，无法搬进 remember。
         lint 把它误判成 FlowOperatorInvokedInComposition，降级为 warning。 -->
    <issue id="FlowOperatorInvokedInComposition" severity="warning" />

    <!-- Media3 的 @UnstableApi 是 error 级 opt-in：项目已在两个播放相关文件加了
         @file:OptIn，Kotlin 编译层面已接受，但 lint 不识别 file 级注解、也不识别
         remember {} lambda 内继承的外层 @OptIn，仍报 6~8 条自指错误。
         这些 API（PlayerView.resizeMode / ProgressiveMediaSource）是播放链路的既定依赖，
         不是待修缺陷；降级为 warning 保留可见性，不再阻塞 lintDebug。 -->
    <issue id="UnsafeOptInUsageError" severity="warning" />
</lint>
